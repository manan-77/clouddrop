add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
add_header X-Frame-Options "DENY" always;
# connect-src allows the presigned S3 uploads (CONNECT_SRC_EXTRA; set it to your endpoint for MinIO).
# Critical CSS is not inlined by the build (angular.json), so style-src needs no 'unsafe-inline'.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ${CONNECT_SRC_EXTRA}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
