server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  # Files go browser <-> S3 directly, so request bodies here are small JSON.
  client_max_body_size 1m;

  # add_header in a location replaces the inherited ones, so each location that sets its own
  # includes the shared security headers explicitly.
  include /etc/nginx/conf.d/security-headers.inc;

  location = /nginx-health {
    access_log off;
    return 200 "ok";
  }

  location ^~ /api {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite, never append: a client-sent X-Forwarded-For must not reach the rate limiter.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 120s;
  }

  location ^~ /health {
    proxy_pass ${API_UPSTREAM};
  }

  # Hashed build files never change, so they can be cached for a year; the entry document never.
  location ~* -[A-Z0-9]{8}\.(?:js|css)$ {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Other files (icons, source maps, manifests): short cache, and a real 404 rather than the SPA.
  location ~* \.(?:js|css|map|json|txt|webmanifest|xml|woff2?|svg|png|ico|jpg|jpeg|webp)$ {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "public, max-age=3600";
    try_files $uri =404;
  }

  location / {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-store";
    try_files $uri /index.html;
  }
}
