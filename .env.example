# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=clouddrop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clouddrop
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://clouddrop:change-me@localhost:5432/clouddrop

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-long-random
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- AWS S3 ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Azure APIM (verify with scripts/check_apim.sh) ---
AZURE_APIM_BASE_URL=
AZURE_APIM_KEY=
AZURE_CHAT_PATH=
AZURE_EMBED_PATH=
