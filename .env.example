# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=clouddrop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clouddrop
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://clouddrop:change-me@localhost:5432/clouddrop

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Malware scanning (ClamAV). `off` skips it and is refused outside development and test.
SCANNER_MODE=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Keep clamd's StreamMaxLength at least as large as SCANNER_MAX_STREAM_BYTES (default 1 GiB, the
# largest multipart upload). MULTIPART_MAX_UPLOAD_BYTES must not exceed it while scanning is on.
SCANNER_TIMEOUT_SECONDS=30
SCANNER_MAX_STREAM_BYTES=1073741824
# Worker tuning (defaults are fine): CELERY_TASK_TIME_LIMIT_SECONDS, CELERY_VISIBILITY_TIMEOUT_SECONDS,
# PROCESSING_MAX_RETRIES, SWEEPER_INTERVAL_SECONDS, SWEEPER_STUCK_AFTER_SECONDS, SWEEPER_BATCH_SIZE

# --- App ---
# One of: development, test, staging, production. Anything other than development/test
# turns on Secure cookies and turns the API docs off.
ENVIRONMENT=development

# --- Auth ---
# At least 32 characters or the API refuses to start. Generate a random one.
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- AWS S3 ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional. Only for S3-compatible stores (for example a local emulator).
S3_ENDPOINT_URL=
# Uploads: bytes. 104857600 = 100 MiB per file, 5368709120 = 5 GiB per user.
MAX_UPLOAD_BYTES=104857600
MULTIPART_MAX_UPLOAD_BYTES=1073741824
MULTIPART_PART_SIZE_BYTES=16777216
MULTIPART_UPLOAD_MAX_AGE_SECONDS=21600
USER_QUOTA_BYTES=5368709120
PRESIGNED_UPLOAD_TTL_SECONDS=900
PRESIGNED_DOWNLOAD_TTL_SECONDS=300
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30
S3_MAX_ATTEMPTS=3

# --- Database pool ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10

# --- Azure APIM (verify with scripts/check_apim.sh) ---
AZURE_APIM_BASE_URL=
AZURE_APIM_KEY=
AZURE_CHAT_PATH=
AZURE_EMBED_PATH=

# List settings are JSON. Defaults are fine for development.
# CORS_ORIGINS=["http://localhost:4200"]
# ALLOWED_CONTENT_TYPES=["application/pdf", "text/plain", "image/png"]
